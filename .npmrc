# Always resolve optional dependencies, including the platform-gated native
# binaries (sharp, @next/swc, @img/*) that Next.js needs on Linux and macOS.
#
# This is npm's default, so it is insurance rather than a behaviour change: a
# global ~/.npmrc, a CI runner, or an NODE_ENV-driven config that sets
# `omit=optional` would otherwise silently strip those binaries and break the
# build on other platforms. Pinning it here means the project decides, not the
# environment it happens to be installed in.
include=optional
